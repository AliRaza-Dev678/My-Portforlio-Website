# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel > Project > Settings > Environment Variables.
# Neither key may be prefixed with NEXT_PUBLIC_: they are read only by the
# /api/chat server route and must never reach the browser.

# RazaMind uses Groq when this is set...
GROQ_API_KEY=
# ...and falls back to OpenAI otherwise. One of the two is required.
OPENAI_API_KEY=

# Optional. Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://ali-raza-engineer.vercel.app
